{
  "name": "dev-monitor",
  "version": "1.3.0",
  "private": true,
  "description": "工程监控 - 手机端实时查看编译 / 运行 / 自检 / 产物，支持 Unreal Engine 与 Node 前端构建（服务端零第三方依赖）",
  "keywords": [
    "unreal",
    "monitor",
    "remote",
    "log",
    "build",
    "node",
    "vite",
    "babel"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/launcher.js",
    "start:noopen": "node bin/launcher.js --no-open",
    "setup": "node bin/setup.js",
    "setup:auto": "node bin/setup.js --yes --force",
    "dist": "node bin/make-dist.js",
    "dist:list": "node bin/make-dist.js --list"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0"
  },
  "_dependencies_note": "服务端本身不需要任何依赖；@capacitor/core 只在重新构建安卓壳（build_apk.bat）时才会用到。"
}
